DB_USERNAME=catapult
DB_PASSWORD=changeme

# Générer avec : openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# URL publique de catapult-web (utilisée pour la redirection post-OAuth2)
# En production : https://your-domain.example.com
APP_BASE_URL=https://your-domain.example.com

# URL publique de catapult-web (pour que catapult-api redirige après OAuth2)
# En production : même valeur que APP_BASE_URL
CATAPULT_WEB_URL=https://your-domain.example.com

# URL interne de catapult-api (pour que catapult-web appelle l'API)
# En Docker Compose : http://catapult-api:8080
CATAPULT_API_URL=http://catapult-api:8080

# JWT — partagé entre catapult-api et catapult-web
# Générer avec : openssl rand -base64 32
JWT_SECRET=

# Twitch ID du propriétaire (obtient ROLE_ADMIN)
APP_OWNER_ID=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

STEAM_API_KEY=

# Optionnel — utilise TWITCH_CLIENT_ID par défaut si non renseigné
IGDB_CLIENT_ID=

# Compte Twitch système (bot) pour les réponses des commandes chat :
# se configure via l'admin UI (page Membres → "Lier le Bot Twitch")
# et non plus par variable d'environnement.

# ── GitLab CI uniquement ─────────────────────────────────────────────────────
# À configurer dans GitLab Settings → CI/CD → Variables (masked)
# TEST_JWT_SECRET=<valeur quelconque en base64, ex: openssl rand -base64 32>
