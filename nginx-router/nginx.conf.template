# catapult-web is stateless across instances (sessions in Redis via Spring Session, browser events
# fanned out over Redis pub/sub), so any number of instances can sit behind this upstream. With
# `docker compose up --scale catapult-web=N`, Docker's DNS answers every replica for the service name
# and nginx balances over all the addresses it resolved at startup; outside compose, list one
# `server` line per instance. Keepalive connections let the long-lived SSE streams and the regular
# requests reuse upstream sockets (needs HTTP/1.1 and an empty Connection header, set below).
upstream frontend {
    server ${UPSTREAM_FRONTEND};
    keepalive 32;
}

upstream backend {
    server ${UPSTREAM_BACKEND};
}

upstream maintenance {
    server ${UPSTREAM_MAINTENANCE};
}

server {
    listen 8080;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto ${FORWARDED_PROTO};
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Port  $server_port;

    proxy_connect_timeout 5s;
    proxy_read_timeout    60s;
    proxy_send_timeout    60s;

    # ── Server-sent event streams ─────────────────────────────────────────────
    # The channel page and nav streams (/events/**), the Twitchat dispatch stream
    # and the OBS widget stream stay open for as long as the page is: no read
    # timeout cut, no buffering (each event leaves at once), HTTP/1.1 keepalive to
    # catapult-web rather than `Connection: close`. Regex locations win over the
    # generic `location /` prefix below.
    # Browsers cap HTTP/1.1 at 6 connections per host, which a few tabs of SSE
    # exhaust: the TLS terminator in front of this router must speak HTTP/2 to
    # the browser (this server only listens in clear text, where browsers never
    # use HTTP/2).
    location ~ ^/(events/|me/twitchat/events$|widget/obs/[^/]+/events$) {
        proxy_pass         http://frontend;
        proxy_http_version 1.1;
        proxy_set_header   Connection        "";
        # nginx drops every inherited proxy_set_header once a location sets one: repeat them
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto ${FORWARDED_PROTO};
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Forwarded-Port  $server_port;
        proxy_read_timeout 24h;         # the app's heartbeats keep the stream alive, not this timer
        proxy_send_timeout 24h;
        proxy_buffering    off;         # forward each event immediately
        proxy_cache        off;
        add_header         X-Accel-Buffering no always;  # for a proxy in front of this one
        error_page 502 503 504 = @maintenance;
    }

    # ── Twitch OAuth2 flow ────────────────────────────────────────────────────
    # Routed directly to catapult-api; the browser never reaches catapult-api:8080.
    # Fall back to the maintenance page if catapult-api is down so the user
    # doesn't see a raw 502 mid-login.
    location /oauth2/ {
        proxy_pass http://backend;
        error_page 502 503 504 = @maintenance;
    }

    location /login/oauth2/ {
        proxy_pass http://backend;
        error_page 502 503 504 = @maintenance;
    }

    # ── Steam OpenID callback (Steam redirects the browser here directly) ─────
    location = /api/connect/steam/callback {
        proxy_pass http://backend;
        error_page 502 503 504 = @maintenance;
    }

    # ── Widget-token-authenticated public API (OBS browser sources fetch this
    # directly, unlike other /api/** routes which catapult-web calls server-side) ─
    location /api/game/ {
        proxy_pass http://backend;
        error_page 502 503 504 = @maintenance;
    }

    # ── User API v2 (see UserApiV2Controller/ApiVersioningConfig) — same public,
    # widget-token-or-platform-id trust model as /api/game/ above ─────────────
    location /api/user/ {
        proxy_pass http://backend;
        error_page 502 503 504 = @maintenance;
    }

    # ── API documentation (springdoc/Swagger UI) ──────────────────────────────
    location = /swagger-ui.html {
        proxy_pass http://backend;
        error_page 502 503 504 = @maintenance;
    }

    location /swagger-ui/ {
        proxy_pass http://backend;
        error_page 502 503 504 = @maintenance;
    }

    location /api/v3/api-docs {
        proxy_pass http://backend;
        error_page 502 503 504 = @maintenance;
    }

    # ── Probe used by maintenance page to detect catapult-web recovery ──────────
    # No error_page fallback here: 502/503/504 bubble up to the browser as-is.
    location = /up {
        proxy_pass            http://frontend/healthz;
        proxy_connect_timeout 2s;
        proxy_read_timeout    3s;
    }

    # ── Everything else goes to catapult-web ──────────────────────────────────
    location / {
        proxy_pass         http://frontend;
        proxy_http_version 1.1;
        proxy_set_header   Connection        "";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto ${FORWARDED_PROTO};
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Forwarded-Port  $server_port;
        error_page 502 503 504 = @maintenance;
    }

    location @maintenance {
        proxy_pass       http://maintenance;
        proxy_set_header Host $host;
    }
}
