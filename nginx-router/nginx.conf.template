upstream frontend {
    server ${UPSTREAM_FRONTEND};
}

# Map directive must live in the http context (top-level for default.conf includes).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream backend {
    server ${UPSTREAM_BACKEND};
}

upstream maintenance {
    server ${UPSTREAM_MAINTENANCE};
}

server {
    listen 8080;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto ${FORWARDED_PROTO};
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Port  $server_port;

    proxy_connect_timeout 5s;
    proxy_read_timeout    60s;
    proxy_send_timeout    60s;

    # ── SSE: live logs and connection events ──────────────────────────────────
    # Must come before the generic `location /` to override timeouts and buffering.
    location ~ ^/channels/[^/]+/(logs|connections)$ {
        proxy_pass         http://frontend;
        proxy_read_timeout 0;           # SSE streams have no fixed end
        proxy_buffering    off;         # Forward events immediately
        proxy_cache        off;
        add_header         X-Accel-Buffering no;  # Disable when behind another proxy
        error_page 502 503 504 = @maintenance;
    }

    # ── Twitch OAuth2 flow ────────────────────────────────────────────────────
    # Routed directly to catapult-api; the browser never reaches catapult-api:8080.
    # Fall back to the maintenance page if catapult-api is down so the user
    # doesn't see a raw 502 mid-login.
    location /oauth2/ {
        proxy_pass http://backend;
        error_page 502 503 504 = @maintenance;
    }

    location /login/oauth2/ {
        proxy_pass http://backend;
        error_page 502 503 504 = @maintenance;
    }

    # ── Steam OpenID callback (Steam redirects the browser here directly) ─────
    location = /api/connect/steam/callback {
        proxy_pass http://backend;
        error_page 502 503 504 = @maintenance;
    }

    # ── Widget-token-authenticated public API (OBS browser sources fetch this
    # directly, unlike other /api/** routes which catapult-web calls server-side) ─
    location /api/game/ {
        proxy_pass http://backend;
        error_page 502 503 504 = @maintenance;
    }

    # ── Probe used by maintenance page to detect catapult-web recovery ──────────
    # No error_page fallback here: 502/503/504 bubble up to the browser as-is.
    location = /up {
        proxy_pass            http://frontend/actuator/health;
        proxy_connect_timeout 2s;
        proxy_read_timeout    3s;
    }

    # ── WebSocket (single connection per tab) ─────────────────────────────────
    # Must come before the generic `location /` so the Upgrade headers and
    # zero read/send timeouts are applied to /ws.
    # NB: nginx drops ALL inherited proxy_set_header directives the moment a
    # location declares one of its own, so the X-Forwarded-* headers from the
    # server scope must be repeated here. This also matters for /ws/auth-ticket
    # (a non-upgrade GET that matches this prefix) — without X-Forwarded-Proto,
    # Spring builds absolute redirect URLs with the inbound scheme (http).
    location /ws {
        proxy_pass         http://frontend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto ${FORWARDED_PROTO};
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Forwarded-Port  $server_port;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering    off;
        error_page 502 503 504 = @maintenance;
    }

    # ── Everything else goes to catapult-web ──────────────────────────────────
    location / {
        proxy_pass         http://frontend;
        error_page 502 503 504 = @maintenance;
    }

    location @maintenance {
        proxy_pass       http://maintenance;
        proxy_set_header Host $host;
    }
}
